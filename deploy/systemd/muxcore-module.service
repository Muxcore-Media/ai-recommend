[Unit]
Description=MuxCore Module - ai-recommend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=muxcore
Group=muxcore
ExecStart=/usr/local/bin/ai-recommend \
  --muxcore-mesh-addr localhost:9090 \
  --muxcore-module-id ai-recommend
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

; Security hardening
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-recommend

[Install]
WantedBy=multi-user.target
